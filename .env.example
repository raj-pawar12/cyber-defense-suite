# Copy this file to ".env" and fill in your own key. NEVER commit the real .env file to GitHub.
# Get a free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=api_key

# Optional: change the model if Google retires or renames it (see the model list in Google AI Studio).
GEMINI_MODEL=gemini-2.5-flash

# Optional: set to 1 when hosting behind a proxy such as Render so rate limits see the real visitor address.
# TRUST_PROXY=1
